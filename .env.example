# 引易转 (YinYiZhuan) 环境变量

# Vercel API 密钥（用于保护 API 端点）
# 生产环境必须设置，否则所有 API 端点公开可访问
API_KEY=your-api-key-here

# Google Books API 密钥（用于 ISBN 元数据抓取）
# 通过 api/google-books.js 服务端代理使用，不暴露到前端
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# 前端编译时变量
# 注意：以 VITE_ 开头的变量会被编译到前端 bundle 中
VITE_GOOGLE_BOOKS_API_KEY=deprecated-use-server-proxy
